# Venice Chat Terminal Configuration
# (Optional) If you have a paid Venice API key, enter it here:
VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Default active model:
# Choices: deepseek-v4.1-flash, zai-org-glm-5-2, venice-uncensored-1-2, default, deepseek-v4-pro
VENICE_MODEL=deepseek-v4.1-flash

# Default backend mode:
# - 'free': Free zero-cost inference using DeepSeek V4.1 Flash ($0 balance needed)
# - 'api': Official Venice API inference (requires prepaid balance)
# - 'web': Automated browser web agent session
VENICE_BACKEND=free

# Web search toggle: auto, on, off
ENABLE_WEB_SEARCH=auto
