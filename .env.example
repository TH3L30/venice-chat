# Venice Chat Configuration
# Get your API key from https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Default active model:
# Choices: deepseek-v4-1-flash, zai-org-glm-5-2, venice-uncensored-1-2, default, deepseek-v4-pro, grok-4-7
VENICE_MODEL=deepseek-v4-1-flash

# Web search toggle: auto, on, off
ENABLE_WEB_SEARCH=auto
